# Copia este archivo como ".env" y rellena los valores reales.
# ".env" ya está en .gitignore, nunca lo subas al repo.

# ── Servidor ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# URL del frontend (Vite dev server) para configurar CORS
CORS_ORIGIN=http://localhost:5173

# ── Base de datos (Supabase Postgres) ──────────────────────
# Project Settings → Database → Connection string, modo "Transaction" (puerto 6543, pgbouncer=true).
# Prisma la usa en runtime para queries normales.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Misma conexión pero en modo "Session" (puerto 5432, sin pgbouncer).
# Prisma la necesita SOLO para migraciones (prisma migrate dev / db pull).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase (Storage / cliente admin) ─────────────────────
# Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Autenticación (fase 1: correo + contraseña con JWT) ────
JWT_SECRET="genera-un-string-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# ── Google OAuth (pendiente, dejar vacío por ahora) ────────
# Se completa cuando exista el proyecto en Google Cloud Console.
# El código de passport-google-oauth20 se deja listo pero deshabilitado
# si estas variables no están presentes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
