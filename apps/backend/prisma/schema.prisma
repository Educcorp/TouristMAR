generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum sexo_enum {
  femenino
  masculino
  otro
  prefiero_no_decir
}

enum rol_enum {
  turista
  negocio
  admin
  super_admin
}

enum estado_negocio_enum {
  pendiente
  aprobado
  rechazado
}

enum notificacion_tipo_enum {
  negocio_pendiente
  negocio_sugerido
  negocio_aprobado
  negocio_rechazado
  usuario_nuevo
}

/// Qué muestra la app cuando la cámara reconoce un marcador. Por ahora el
/// módulo de Unity solo pinta `texto` (tarjeta flotante con TextMeshPro); los
/// demás quedan listos para cuando se agreguen modelos 3D, imágenes o videos
/// encima del marcador (el archivo va en `contenido_url`).
enum ar_contenido_enum {
  texto
  imagen
  modelo_3d
  video
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?    @map("password_hash")
  nombres         String
  apellidos       String?
  username        String?    @unique
  fechaNacimiento DateTime?  @map("fecha_nacimiento") @db.Date
  sexo            sexo_enum?
  rol             rol_enum   @default(turista)
  activo          Boolean    @default(true)
  bio             String?
  avatarUrl       String?    @map("avatar_url")
  googleId        String?    @unique @map("google_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  negocios      NegocioProfile[]
  notifications Notification[]
  arMarcadores  ArMarcador[]
  arEscaneos    ArEscaneo[]

  @@map("users")
}

model NegocioProfile {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre      String
  categoria   String?
  descripcion String?
  direccion   String?
  telefono    String?
  sitioWeb    String?             @map("sitio_web")
  horario     String?
  portada     String?
  galeria     String[]            @default([])
  archivo360  String?             @map("archivo_360")
  arMarcador  String?             @map("ar_marcador_url")
  arGeo       String?             @map("ar_geo_url")
  estado      estado_negocio_enum @default(pendiente)
  revisadoPor String?             @map("revisado_por") @db.Uuid
  revisadoEn  DateTime?           @map("revisado_en")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  arMarcadores ArMarcador[]

  @@index([userId])
  @@map("negocio_profiles")
}

/// Notificación puntual para una cuenta (admin o dueño de negocio). No hay
/// destinatario "por rol" — al ocurrir un evento se crea una fila por cada
/// admin vigente (fan-out simple, son pocas cuentas) o una sola fila para el
/// dueño de un negocio puntual.
model Notification {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      notificacion_tipo_enum
  titulo    String
  cuerpo    String
  negocioId String?                @map("negocio_id") @db.Uuid
  leida     Boolean                @default(false)
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([userId, leida])
  @@map("notifications")
}

/// Imagen que la cámara AR reconoce (una gaviota, un barco, un letrero…) más
/// la información que se muestra flotando encima. Lo dan de alta los admins
/// desde el panel web; el módulo de Unity descarga la lista pública
/// (`GET /api/ar/marcadores`) y agrega cada imagen a su biblioteca de rastreo
/// en tiempo de ejecución, sin recompilar la app.
///
/// El `id` es también el nombre con el que la imagen se registra en la
/// `MutableRuntimeReferenceImageLibrary` de Unity — así, al detectar una
/// imagen, Unity sabe exactamente a qué fila corresponde.
model ArMarcador {
  id            String            @id @default(uuid()) @db.Uuid
  /// Opcional: un marcador puede pertenecer a un negocio (su letrero, su
  /// menú) o ser del destino en general (un monumento, la bahía).
  negocioId     String?           @map("negocio_id") @db.Uuid
  negocio       NegocioProfile?   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre        String
  imagenUrl     String            @map("imagen_url")
  /// Ruta dentro del bucket (sin el `?v=`) — hace falta para borrar el
  /// archivo de Storage al eliminar el marcador.
  imagenPath    String            @map("imagen_path")
  /// Ancho físico real de la imagen impresa, en metros. ARCore/ARKit lo usan
  /// para estimar la escala y detectar más rápido; null = desconocido.
  anchoMetros   Float?            @map("ancho_metros")
  titulo        String
  texto         String
  tipoContenido ar_contenido_enum @default(texto) @map("tipo_contenido")
  contenidoUrl  String?           @map("contenido_url")
  activo        Boolean           @default(true)
  creadoPor     String?           @map("creado_por") @db.Uuid
  autor         User?             @relation(fields: [creadoPor], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  escaneos ArEscaneo[]

  @@index([activo])
  @@index([negocioId])
  @@map("ar_marcadores")
}

/// Un registro cada vez que la cámara reconoce un marcador (una vez por
/// marcador por sesión de AR, lo controla Unity). Alimenta las estadísticas
/// del panel; `userId` solo se llena si la app mandó el token del turista.
model ArEscaneo {
  id         String     @id @default(uuid()) @db.Uuid
  marcadorId String     @map("marcador_id") @db.Uuid
  marcador   ArMarcador @relation(fields: [marcadorId], references: [id], onDelete: Cascade)
  userId     String?    @map("user_id") @db.Uuid
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  plataforma String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([marcadorId, createdAt])
  @@map("ar_escaneos")
}
