generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum sexo_enum {
  femenino
  masculino
  otro
  prefiero_no_decir
}

enum rol_enum {
  turista
  negocio
  admin
  super_admin
}

enum estado_negocio_enum {
  pendiente
  aprobado
  rechazado
}

enum notificacion_tipo_enum {
  negocio_pendiente
  negocio_sugerido
  negocio_aprobado
  negocio_rechazado
  usuario_nuevo
  recorrido_solicitado
  recorrido_listo
  recorrido_rechazado
}

/// Estado de una solicitud de recorrido 360° que manda un negocio.
enum solicitud_recorrido_estado_enum {
  pendiente
  completada
  rechazada
}

/// Qué muestra la app cuando la cámara reconoce un marcador. Por ahora el
/// módulo de Unity solo pinta `texto` (tarjeta flotante con TextMeshPro); los
/// demás quedan listos para cuando se agreguen modelos 3D, imágenes o videos
/// encima del marcador (el archivo va en `contenido_url`).
enum ar_contenido_enum {
  texto
  imagen
  modelo_3d
  video
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?    @map("password_hash")
  nombres         String
  apellidos       String?
  username        String?    @unique
  fechaNacimiento DateTime?  @map("fecha_nacimiento") @db.Date
  sexo            sexo_enum?
  rol             rol_enum   @default(turista)
  activo          Boolean    @default(true)
  bio             String?
  avatarUrl       String?    @map("avatar_url")
  googleId        String?    @unique @map("google_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  negocios                      NegocioProfile[]
  notifications                 Notification[]
  arMarcadores                  ArMarcador[]
  arEscaneos                    ArEscaneo[]
  recorridos360                 Recorrido360[]
  favoritos                     Favorito[]
  resenas                       Resena[]
  solicitudesRecorridoAtendidas SolicitudRecorrido360[] @relation("SolicitudAtendidaPor")

  @@map("users")
}

model NegocioProfile {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre      String
  categoria   String?
  descripcion String?
  direccion   String?
  telefono    String?
  sitioWeb    String?             @map("sitio_web")
  horario     String?
  portada     String?
  galeria     String[]            @default([])
  archivo360  String?             @map("archivo_360")
  arMarcador  String?             @map("ar_marcador_url")
  arGeo       String?             @map("ar_geo_url")
  latitud     Float?
  longitud    Float?
  estado      estado_negocio_enum @default(pendiente)
  revisadoPor String?             @map("revisado_por") @db.Uuid
  revisadoEn  DateTime?           @map("revisado_en")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  arMarcadores         ArMarcador[]
  recorridos360        Recorrido360[]
  favoritos            Favorito[]
  resenas       Resena[]
  solicitudesRecorrido SolicitudRecorrido360[]

  @@index([userId])
  @@map("negocio_profiles")
}

/// Notificación puntual para una cuenta (admin o dueño de negocio). No hay
/// destinatario "por rol" — al ocurrir un evento se crea una fila por cada
/// admin vigente (fan-out simple, son pocas cuentas) o una sola fila para el
/// dueño de un negocio puntual.
model Notification {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      notificacion_tipo_enum
  titulo    String
  cuerpo    String
  negocioId String?                @map("negocio_id") @db.Uuid
  leida     Boolean                @default(false)
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([userId, leida])
  @@map("notifications")
}

/// Imagen que la cámara AR reconoce (una gaviota, un barco, un letrero…) más
/// la información que se muestra flotando encima. Lo dan de alta los admins
/// desde el panel web; el módulo de Unity descarga la lista pública
/// (`GET /api/marcadores`) y agrega cada imagen a su biblioteca de rastreo
/// en tiempo de ejecución, sin recompilar la app.
///
model ArMarcador {
  id            String            @id @default(uuid()) @db.Uuid
  /// Opcional: un marcador puede pertenecer a un negocio (su letrero, su
  /// menú) o ser del destino en general (un monumento, la bahía).
  negocioId     String?           @map("negocio_id") @db.Uuid
  negocio       NegocioProfile?   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  /// Identificador legible y único (p. ej. "gaviota_01"). Es el nombre con el
  /// que Unity registra la imagen en su biblioteca de rastreo y la clave con
  /// la que busca el texto al detectarla — ver GET /api/marcadores.
  nombre        String            @unique
  imagenUrl     String            @map("imagen_url")
  /// Ruta dentro del bucket (sin el `?v=`) — hace falta para borrar el
  /// archivo de Storage al eliminar el marcador.
  imagenPath    String            @map("imagen_path")
  /// Ancho físico real de la imagen impresa, en metros. ARCore/ARKit lo usan
  /// para estimar la escala y detectar más rápido; null = desconocido.
  anchoMetros   Float?            @map("ancho_metros")
  titulo        String
  texto         String
  tipoContenido ar_contenido_enum @default(texto) @map("tipo_contenido")
  contenidoUrl  String?           @map("contenido_url")
  activo        Boolean           @default(true)
  creadoPor     String?           @map("creado_por") @db.Uuid
  autor         User?             @relation(fields: [creadoPor], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  escaneos ArEscaneo[]

  @@index([activo])
  @@index([negocioId])
  @@map("ar_marcadores")
}

/// Un registro cada vez que la cámara reconoce un marcador (una vez por
/// marcador por sesión de AR, lo controla Unity). Alimenta las estadísticas
/// del panel; `userId` solo se llena si la app mandó el token del turista.
model ArEscaneo {
  id         String     @id @default(uuid()) @db.Uuid
  marcadorId String     @map("marcador_id") @db.Uuid
  marcador   ArMarcador @relation(fields: [marcadorId], references: [id], onDelete: Cascade)
  userId     String?    @map("user_id") @db.Uuid
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  plataforma String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([marcadorId, createdAt])
  @@map("ar_escaneos")
}

/// Recorrido 360° de un lugar: de 1 a 32 escenarios (cada uno una foto 360°
/// equirectangular ya unida) conectados entre sí con flechas. El turista
/// entra por el escenario 1 y pasa de uno a otro tocando las flechas. Lo da
/// de alta un admin desde el panel web; el módulo de Unity descarga la lista
/// pública (`GET /api/recorridos`) y baja cada foto cuando la necesita.
model Recorrido360 {
  id        String          @id @default(uuid()) @db.Uuid
  /// Opcional: el recorrido puede ser de un negocio (su hotel, su
  /// restaurante) o del destino en general (el Cerro del Vigía, la bahía).
  negocioId String?         @map("negocio_id") @db.Uuid
  negocio   NegocioProfile? @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  /// Identificador legible y único (p. ej. "cerro_vigia_360") con el que
  /// Unity pide o reconoce el recorrido — ver GET /api/recorridos.
  nombre    String          @unique
  titulo    String
  texto     String
  /// Dónde está el recorrido (pin en el mapa). Propio del recorrido: un
  /// recorrido general (FIME, un mirador) no tiene negocio del cual tomarlo.
  /// null = sin ubicación (solo se abre desde la ficha del lugar).
  latitud   Float?
  longitud  Float?
  activo    Boolean         @default(true)
  creadoPor String?         @map("creado_por") @db.Uuid
  autor     User?           @relation(fields: [creadoPor], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  escenas Recorrido360Escena[]

  @@index([activo])
  @@index([negocioId])
  @@map("recorridos_360")
}

/// Un escenario del recorrido: un punto donde se paró la cámara 360° (la
/// entrada, el lobby, la alberca…). `orden` es su casilla (0 = Escenario 1,
/// el de entrada): el admin sube cada foto en su casilla, así el orden no
/// depende de en qué orden se suban. El backend la guarda ya optimizada (JPG
/// de máx. 4096×2048) más una miniatura para el panel.
model Recorrido360Escena {
  id            String       @id @default(uuid()) @db.Uuid
  recorridoId   String       @map("recorrido_id") @db.Uuid
  recorrido     Recorrido360 @relation(fields: [recorridoId], references: [id], onDelete: Cascade)
  orden         Int
  /// Nombre que ve el turista ("Lobby", "Alberca"). Vacío = "Escenario N".
  titulo        String       @default("")
  descripcion   String       @default("")
  /// Hacia dónde mira la cámara al entrar al escenario, en grados (0 = el
  /// centro de la foto equirectangular, positivo hacia la derecha).
  yawInicial    Float        @default(0) @map("yaw_inicial")
  imagenUrl     String       @map("imagen_url")
  /// Rutas dentro del bucket — hacen falta para borrar los archivos de
  /// Storage al reemplazar la foto o eliminar el recorrido.
  imagenPath    String       @map("imagen_path")
  miniaturaUrl  String       @map("miniatura_url")
  miniaturaPath String       @map("miniatura_path")
  ancho         Int
  alto          Int
  /// Peso del JPG optimizado (lo que descarga el celular), en bytes.
  pesoBytes     Int          @map("peso_bytes")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  enlaces  Recorrido360Enlace[] @relation("EnlaceOrigen")
  entradas Recorrido360Enlace[] @relation("EnlaceDestino")

  @@unique([recorridoId, orden])
  @@map("recorrido_360_escenas")
}

/// Flecha (hotspot) dentro de un escenario que lleva a otro escenario del
/// mismo recorrido. `yaw`/`pitch` son la posición de la flecha en la foto,
/// en grados: yaw -180…180 (0 = centro de la foto), pitch -90…90 (0 = el
/// horizonte, negativo = hacia el piso).
model Recorrido360Enlace {
  id        String             @id @default(uuid()) @db.Uuid
  origenId  String             @map("origen_id") @db.Uuid
  origen    Recorrido360Escena @relation("EnlaceOrigen", fields: [origenId], references: [id], onDelete: Cascade)
  destinoId String             @map("destino_id") @db.Uuid
  destino   Recorrido360Escena @relation("EnlaceDestino", fields: [destinoId], references: [id], onDelete: Cascade)
  yaw       Float
  pitch     Float              @default(0)
  /// Texto opcional junto a la flecha ("Ir a la alberca"). Vacío = el
  /// título del escenario destino.
  etiqueta  String             @default("")
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([origenId, destinoId])
  @@index([destinoId])
  @@map("recorrido_360_enlaces")
}

/// Lugar (negocio aprobado) que un visitante guardó en "Mis favoritos". Un
/// visitante no puede repetir el mismo lugar; si el usuario o el negocio se
/// borran, el favorito se va con ellos.
model Favorito {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  negocioId String         @map("negocio_id") @db.Uuid
  negocio   NegocioProfile @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([userId, negocioId])
  @@index([userId, createdAt])
  @@map("favoritos")
}

/// Un negocio pide que un admin le haga su recorrido 360° (la toma de fotos
/// la agenda el equipo; el negocio solo deja su ubicación en el mapa). Solo
/// puede haber una pendiente por negocio. Cuando el admin crea un recorrido
/// para ese negocio, sus solicitudes pendientes pasan a `completada` solas.
model SolicitudRecorrido360 {
  id          String                          @id @default(uuid()) @db.Uuid
  negocioId   String                          @map("negocio_id") @db.Uuid
  negocio     NegocioProfile                  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  /// Comentario opcional del negocio ("mejor por las mañanas", "son 3 pisos").
  mensaje     String                          @default("")
  estado      solicitud_recorrido_estado_enum @default(pendiente)
  /// Respuesta del admin al atenderla (sobre todo al rechazarla).
  nota        String                          @default("")
  atendidaPor String?                         @map("atendida_por") @db.Uuid
  admin       User?                           @relation("SolicitudAtendidaPor", fields: [atendidaPor], references: [id], onDelete: SetNull)
  atendidaEn  DateTime?                       @map("atendida_en")
  createdAt   DateTime                        @default(now()) @map("created_at")

  @@index([negocioId, createdAt])
  @@index([estado, createdAt])
  @@map("solicitudes_recorrido_360")
}

/// Reseña de un visitante sobre un lugar (negocio aprobado): estrellas de 1 a
/// 5 y un comentario opcional. Cada visitante tiene a lo más una por lugar
/// (la puede editar o borrar). El dueño del negocio puede dejar una
/// respuesta pública; solo un admin puede borrar reseñas ajenas.
model Resena {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  negocioId   String         @map("negocio_id") @db.Uuid
  negocio     NegocioProfile @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  estrellas   Int
  comentario  String?
  respuesta   String?
  respuestaEn DateTime?      @map("respuesta_en")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([userId, negocioId])
  @@index([negocioId, createdAt])
  @@map("resenas")
}
