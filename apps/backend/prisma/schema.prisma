generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum sexo_enum {
  femenino
  masculino
  otro
  prefiero_no_decir
}

enum rol_enum {
  turista
  negocio
  admin
  super_admin
}

enum estado_negocio_enum {
  pendiente
  aprobado
  rechazado
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?    @map("password_hash")
  nombres         String
  apellidos       String?
  username        String?    @unique
  fechaNacimiento DateTime?  @map("fecha_nacimiento") @db.Date
  sexo            sexo_enum?
  rol             rol_enum   @default(turista)
  activo          Boolean    @default(true)
  bio             String?
  avatarUrl       String?    @map("avatar_url")
  googleId        String?    @unique @map("google_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  negocio NegocioProfile?

  @@map("users")
}

model NegocioProfile {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre      String
  categoria   String?
  descripcion String?
  direccion   String?
  telefono    String?
  sitioWeb    String?             @map("sitio_web")
  horario     String?
  portada     String?
  galeria     String[]            @default([])
  archivo360  String?             @map("archivo_360")
  arMarcador  String?             @map("ar_marcador_url")
  arGeo       String?             @map("ar_geo_url")
  estado      estado_negocio_enum @default(pendiente)
  revisadoPor String?             @map("revisado_por") @db.Uuid
  revisadoEn  DateTime?           @map("revisado_en")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("negocio_profiles")
}
